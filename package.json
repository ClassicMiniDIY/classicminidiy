{
  "name": "classicminidiy",
  "type": "module",
  "version": "10.0.0",
  "description": "Classic Mini DIY - The Classic Mini Knowledgebase",
  "author": {
    "name": "Cole Gentry",
    "email": "hello@colegentry.io",
    "url": "https://github.com/SomethingNew71"
  },
  "license": "GPL-3.0",
  "private": false,
  "fix-absolute": "sed -i '/  .basedir.: /d' .nuxt/dist/server-bundle.json",
  "repository": {
    "type": "git",
    "url": "git://github.com/SomethingNew71/classicminidiy.git"
  },
  "homepage": "https://classicminidiy.com",
  "bugs": {
    "url": "https://github.com/SomethingNew71/classicminidiy/issues"
  },
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "TMPDIR=/tmp nuxi dev",
    "build": "nuxi build",
    "start": "nuxi preview",
    "format": "prettier --write .",
    "format:check": "node scripts/format-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:routes": "node scripts/smoke-routes.mjs",
    "test:e2e": "playwright test",
    "typecheck": "nuxi prepare && node scripts/typecheck.mjs",
    "gen:types": "supabase gen types typescript --project-id psoqirvbujwohemmwplv > types/database.ts"
  },
  "overrides": {
    "vue": "3.5.42",
    "@vue/compiler-core": "3.5.42",
