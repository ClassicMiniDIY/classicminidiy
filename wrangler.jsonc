{
  // Cloudflare Workers deploy config for classicminidiy.
  //
  // Phase 2: this deploys to workers.dev only. No `routes` block yet, so nothing
  // here can serve production traffic — the switch to Cloudflare is the Phase 4
  // grey-cloud DNS flip plus a proxy toggle, NOT a code change.
  //
  // Pin wrangler and compatibility_date together (plan amendment E5): bump
  // wrangler first, compatibility_date second.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classicminidiy",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    // LOAD-BEARING. Vercel serves prerendered routes at their NO-SLASH url as
    // 200. The Workers assets default (auto-trailing-slash) 307s
    // /technical/torque -> /technical/torque/ instead, which would break every
    // canonical and every sitemap entry on the site at once.
    //
    // Measured on the Phase 0 spike: without this, /technical/torque,
    // /archive/colors and /models all 307'd while production served all three
    // as 200. With it, the no-slash form is 200 and the slashed form redirects
    // back to it — matching Vercel exactly. Do not remove.
    "html_handling": "drop-trailing-slash"
  },

  // Nitro's cached handlers write to `cache:`. On workers the default storage is
  // per-isolate memory — no sharing between isolates, no persistence — so it is
  // mounted onto KV in nuxt.config.ts (gated on isCloudflareBuild). The binding
  // name must match the `cache` mount there.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "7563084adc0845469b5a5ec60226d3b0"
    }
  ],

  // Worker routes. These are what put the worker in front of production traffic —
  // but ONLY once the zone's records are proxied. A route on a grey-clouded record
  // is inert, which is the whole basis of the cutover sequence: flip NS (invisible),
  // wait for the cert, add routes (still inert), then proxy = the actual switch.
  //
  // Deliberately ROUTES, not a custom domain. A custom domain requires DELETING the
  // production DNS record, so rollback means recreating it under pressure. A route
  // plus a proxied record rolls back with a single `proxied: false` toggle.
  //
  // theminiexchange.com is NOT here: its 28 redirects are served by zone-edge rules,
  // which cost no worker invocation and keep working during a worker outage.
  "routes": [
    { "pattern": "classicminidiy.com/*", "zone_name": "classicminidiy.com" },
    { "pattern": "www.classicminidiy.com/*", "zone_name": "classicminidiy.com" }
  ],

  "observability": {
    "enabled": true
  }
}
