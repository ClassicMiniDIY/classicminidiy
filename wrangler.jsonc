{
  // THROWAWAY Phase 0 spike config. Not the production worker.
  //
  // Deploys to a workers.dev subdomain with no routes and no zone attached, so
  // nothing here can touch classicminidiy.com. Phase 2 replaces this wholesale
  // with the real config (routes, KV, run_worker_first, secrets).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cmdiy-spike",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    // Vercel serves prerendered routes at their NO-SLASH url as 200. The Workers
    // assets default (auto-trailing-slash) 307s /technical/torque ->
    // /technical/torque/ instead, which would break every canonical and every
    // sitemap entry at once. drop-trailing-slash serves the no-slash form as 200
    // and redirects the slashed form back to it, matching Vercel. Measured, not
    // assumed: without this the spike 307'd /technical/torque, /archive/colors
    // and /models while production served all three as 200.
    "html_handling": "drop-trailing-slash"
  },
  // Spike KV namespace, mounted as a nitro storage in nuxt.config.ts (gated on
  // isCloudflareBuild). Phase 2 replaces this with the real cache namespace.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "fe83d337d18046468b17e3cb31d61728"
    }
  ],
  "observability": {
    "enabled": true
  }
}
